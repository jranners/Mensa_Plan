{
  "name": "mensa-plan",
  "version": "1.0.0",
  "description": "Optimizing KStW Mensaplan PWA load times",
  "main": "app.js",
  "scripts": {
    "build:css": "tailwindcss -i input.css -o styles.css --minify",
    "watch:css": "tailwindcss -i input.css -o styles.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rpc": "node scripts/check-rpc.mjs",
    "check:sw": "node scripts/check-sw-version.mjs"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "tailwindcss": "^3.4.1",
    "vitest": "^4.1.11"
  }
}
